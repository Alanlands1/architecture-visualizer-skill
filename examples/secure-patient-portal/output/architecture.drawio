        </mxCell>
        <mxCell id="n_edge_fw" value="&lt;b&gt;Edge Firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#526579&quot;&gt;Firewall&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#34495E&quot;&gt;Only allows HTTPS on port 443 and drops the rest&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FBE9E0;strokeColor=#3069A4;strokeWidth=2;fontColor=#183153;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="z_1">
